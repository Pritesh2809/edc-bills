rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // Helper function to check if user is member
    function isMember() {
      return isAuthenticated() && getUserData().role == 'member';
    }

    // Users collection - only admins can write, authenticated users can read their own data
    match /users/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    // Trips collection - admins can write, members can read trips they're part of
    match /trips/{tripId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Receipts collection - members can create, admins can do everything
    match /receipts/{receiptId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isMember();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uploader_id == request.auth.uid);
    }

    // Audit logs - read-only for admins
    match /audit/{auditId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }
  }
}
