rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Receipts can be uploaded by authenticated members
    // Can be read by authenticated users
    match /receipts/{tripId}/{receiptFile} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
